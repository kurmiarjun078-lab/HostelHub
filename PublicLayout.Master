<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PublicLayout.master.cs" Inherits="HostelHub.PublicLayout" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - HostelHub</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" runat="server" />
    <link href="~/Content/Site.css" rel="stylesheet" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <nav class="hh-nav">
            <a class="hh-brand" href="~/Public/Default.aspx" runat="server">HostelHub</a>

            <div class="hh-links">
                <a href="~/Public/Default.aspx" runat="server">Home</a>
                <a href="~/Public/Default.aspx#features" runat="server">Features</a>
                <a href="~/Public/Default.aspx#how" runat="server">How It Works</a>
                <a href="~/Public/About.aspx" runat="server">About</a>
                <a href="~/Public/Contact.aspx" runat="server">Contact</a>
            </div>

            <div class="hh-auth">
                <a class="login-link" href="~/Account/Login.aspx" runat="server">Login</a>
                <a class="btn-hh-dark" href="~/Account/Register.aspx" runat="server">Get Started</a>
            </div>
        </nav>

        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

        <footer class="hh-footer">
            © <%: DateTime.Now.Year %> HostelHub. All rights reserved.
        </footer>

    </form>
</body>
</html>